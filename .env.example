# UPS Developer Portal credentials
# Register at https://developer.ups.com and create an App to get these
UPS_CLIENT_ID=your_client_id_here
UPS_CLIENT_SECRET=your_client_secret_here

# Your UPS account number (6-digit shipper number)
UPS_ACCOUNT_NUMBER=your_account_number_here

# Quantum View subscription name(s) — comma-separated if multiple
# Set these up in Quantum View Manage or ask UPS account support
UPS_QV_SUBSCRIPTIONS=your_subscription_name_here

# Use "sandbox" or "production"
UPS_ENVIRONMENT=sandbox

# How many days back to pull on first sync (max 7 per QV request, but we'll paginate)
INITIAL_SYNC_DAYS=30

# Flask settings
FLASK_SECRET_KEY=change-this-to-a-random-string
DATABASE_URL=sqlite:///ups_shipments.db
